    "svg2pdf.js": "^2.7.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.4.0",
    "playwright": "^1.61.1",
    "typescript": "^5.7.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.0"
  }
