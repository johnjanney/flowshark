{
  "name": "flowshark",
  "productName": "FlowShark",
  "version": "0.1.0",
  "description": "A fast, native-feeling flowchart application for Windows on ARM",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
